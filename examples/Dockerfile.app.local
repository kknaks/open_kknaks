FROM python:3.12-slim

WORKDIR /src

COPY pyproject.toml README.md ./
COPY open_kknaks/ ./open_kknaks/

ENV SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0+local
RUN pip install --no-cache-dir . fastapi "uvicorn[standard]" jinja2 sse-starlette

WORKDIR /app
COPY examples/app/ .

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
